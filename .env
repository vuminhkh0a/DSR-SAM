# y_DG CUDA configuration -----------------------------------------------------
# Single source of truth for the GPU used by every entrypoint (main.py) in this
# project. Read at runtime by utils/env.py (no python-dotenv required).
#
# To move everything to another GPU, change the value below, e.g.:
#   CUDA_DEVICE=cuda:2
#   CUDA_DEVICE=cuda:0
#   CUDA_DEVICE=cpu
# A value exported in the shell (export CUDA_DEVICE=cuda:3) takes precedence.
CUDA_DEVICE=cuda:2
